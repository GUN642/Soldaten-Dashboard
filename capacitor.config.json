{
  "appId": "de.gun.dienstcockpit",
  "appName": "Soldaten Dashboard",
  "webDir": "www",
  "android": {
    "allowMixedContent": false
  },
  "server": {
    "androidScheme": "https",
    "allowNavigation": [
      "*.meteoblue.com",
      "meteoblue.com",
      "*.open-meteo.com",
      "open-meteo.com",
      "openholidaysapi.org"
    ]
  },
  "plugins": {
    "SplashScreen": {
      "backgroundColor": "#191919",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false,
      "launchAutoHide": true,
      "launchShowDuration": 900
    }
  }
}