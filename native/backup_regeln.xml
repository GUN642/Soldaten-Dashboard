<?xml version="1.0" encoding="utf-8"?>
<!--
  Sicherungsregeln fuer Android 11 und aelter (fullBackupContent).

  Gesichert werden die SharedPreferences (dort liegt der vollstaendige
  Spiegel aller App-Daten, den die App bei jeder Aenderung mitschreibt,
  siehe speicherSpiegeln/saveJSON in www/index.html) sowie der Ordner
  "anhaenge" im internen Dateispeicher (domain="file", entspricht
  Capacitor Directory.DATA) - dort liegen seit der Umstellung auf
  Filesystem-Anhaenge (siehe anhangSchreiben in www/index.html) die
  Bilddateien zu Akte, Dokumenten, Lehrgaengen, Terminen und Aufgaben,
  statt wie frueher als Base64 mitten in den SharedPreferences.

  Die WebView-Ablage (app_webview/Local Storage) wird bewusst NICHT
  mitgesichert: Das ist eine LevelDB-Datenbank, die beim Zurueckspielen
  inkonsistent werden kann. Sie wird nach der Wiederherstellung ohnehin
  von speicherZurueckholen() aus dem Spiegel neu aufgebaut - genau dafuer
  wurde der Spiegel gebaut.
-->
<full-backup-content>
    <include domain="sharedpref" path="." />
    <include domain="file" path="anhaenge" />
    <exclude domain="file" path="app_webview" />
    <exclude domain="external" path="." />
</full-backup-content>
