<?xml version="1.0" encoding="utf-8"?>
<!-- Aufbau des Widgets: Kopfzeile mit Datum, darunter eine scrollbare Liste.
     Die Liste wird von AgendaWidgetService gefuellt. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/hintergrund"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="#D90E1319">

        <LinearLayout
            android:id="@+id/kopfBereich"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:baselineAligned="false"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/datum"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="18sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="#F2F5F9"
                android:text="Soldaten Dashboard" />

            <TextView
                android:id="@+id/kopfZusatz"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:maxLines="1"
                android:paddingLeft="8dp"
                android:textColor="#AAB4C2" />
        </LinearLayout>

        <TextView
            android:id="@+id/leerHinweis"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:paddingTop="6dp"
            android:visibility="gone"
            android:textColor="#AAB4C2"
            android:text="Heute nichts eingetragen" />

        <ListView
            android:id="@+id/liste"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:scrollbars="none" />

    </LinearLayout>
</FrameLayout>
