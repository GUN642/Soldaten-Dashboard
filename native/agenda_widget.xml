<?xml version="1.0" encoding="utf-8"?>
<!-- Aufbau des Widgets: Kopfzeile mit Datum, darunter bis zu acht Zeilen.
     Alle Zeilen stehen unmittelbar hier, da Widgets mit eingebundenen
     Layouts nicht zuverlaessig umgehen. Erlaubt sind zudem nur bestimmte
     Elementtypen; deshalb TextView statt View fuer die Farbmarken. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/hintergrund"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="10dp"
        android:background="#D90E1319">

        <LinearLayout
            android:id="@+id/kopfBereich"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:paddingBottom="5dp">

            <TextView
                android:id="@+id/datum"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="14sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="#F2F5F9"
                android:text="Soldaten Dashboard" />

            <TextView
                android:id="@+id/kopfZusatz"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:maxLines="1"
                android:paddingLeft="6dp"
                android:textColor="#AAB4C2" />
        </LinearLayout>

        <TextView
            android:id="@+id/leerHinweis"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:paddingTop="6dp"
            android:visibility="gone"
            android:textColor="#AAB4C2"
            android:text="Heute nichts eingetragen" />

        <LinearLayout
            android:id="@+id/zeile1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:baselineAligned="false"
            android:paddingTop="3dp"
            android:paddingBottom="3dp">

            <TextView
                android:id="@+id/farbe1"
                android:layout_width="4dp"
                android:layout_height="15dp"
                android:text=""
                android:background="#8B96A5" />

            <TextView
                android:id="@+id/zeit1"
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:maxLines="1"
                android:paddingLeft="6dp"
                android:textColor="#AAB4C2" />

            <TextView
                android:id="@+id/titel1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:paddingLeft="4dp"
                android:textColor="#F2F5F9" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/zeile2"
