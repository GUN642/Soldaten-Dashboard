<?xml version="1.0" encoding="utf-8"?>
<!-- Aufbau des Widgets: Kopfzeile mit Datum, darunter bis zu acht Zeilen -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/hintergrund"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="10dp"
        android:background="#D90E1319">

        <!-- Kopfzeile: Antippen oeffnet die App -->
        <LinearLayout
            android:id="@+id/kopfBereich"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:paddingBottom="6dp">

            <TextView
                android:id="@+id/datum"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="14sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="#F2F5F9"
                android:text="Soldaten Dashboard" />

            <TextView
                android:id="@+id/kopfZusatz"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:maxLines="1"
                android:paddingStart="6dp"
                android:paddingLeft="6dp"
                android:textColor="#AAB4C2" />
        </LinearLayout>

        <TextView
            android:id="@+id/leerHinweis"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:paddingTop="8dp"
            android:visibility="gone"
            android:textColor="#AAB4C2"
            android:text="Heute nichts eingetragen" />

        <!-- Acht Zeilen; nicht belegte werden ausgeblendet -->
        <include layout="@layout/agenda_zeile1" />
        <include layout="@layout/agenda_zeile2" />
        <include layout="@layout/agenda_zeile3" />
        <include layout="@layout/agenda_zeile4" />
        <include layout="@layout/agenda_zeile5" />
        <include layout="@layout/agenda_zeile6" />
        <include layout="@layout/agenda_zeile7" />
        <include layout="@layout/agenda_zeile8" />

    </LinearLayout>
</FrameLayout>
